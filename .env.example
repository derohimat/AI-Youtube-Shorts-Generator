# Copy to .env and fill in what you use.

# Which AI picks the clips: openai | anthropic | gemini | ollama | heuristic (no key, basic)
LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-nano          # optional, default depends on provider

OPENAI_API=your_openai_api_key_here
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Whisper model: tiny | base | small | medium | large-v3 (bigger = more accurate, slower)
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=en           # leave unset to auto-detect

# OUTPUT_DIR=output
# WORK_DIR=work
# USE_NVENC=false               # true = use NVIDIA GPU video encoder
